<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FO4_NPC_Manager</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../FO4_NPC_Manager/NPC/AdultTransformation.vb" Link="AdultTransformation.vb" />
    <Compile Include="../../FO4_NPC_Manager/NPC/BatchJournal.vb" Link="BatchJournal.vb" />
    <Compile Include="BatchJournalTests.vb" />
    <Compile Include="Program.vb" />
  </ItemGroup>
</Project>
